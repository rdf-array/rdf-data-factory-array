{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "es6",
    "lib": [
      "es6"
    ],
    "module": "commonjs",
    "types": [
      "node",
      "jest"
    ],
    "strict": true,
    "noImplicitAny": true,
    "declaration": true,
    "importHelpers": false,
    "inlineSources": true,
    "preserveConstEnums": true,
    "removeComments": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "lib/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/test/*"
  ]
}
